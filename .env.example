# Copy to .env.local and fill in. Never commit real values.
# Stripe secret key (sk_test_... or sk_live_...). NOTE: the name is misspelled in the code (SRTIPE) - keep as is.
SRTIPE_SECRET_KEY=
# Public base URL of the app (used for Stripe success/cancel redirects), e.g. http://<VM_IP>:3000
NEXT_URL=http://localhost:3000
# Optional: show a clearly-labeled demo catalog (not purchasable) when Stripe returns empty/error. Default off.
NEXT_PUBLIC_USE_FALLBACK_PRODUCTS=false
